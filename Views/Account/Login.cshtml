
@{
    ViewData["Title"] = "Login";
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>SCM ProcureTrack - Login</title>

    <link href="https://cdn.jsdelivr.net/npm/bootstrap@5.3.3/dist/css/bootstrap.min.css"
          rel="stylesheet" />

    <style>
        body {
            background: #f1f5f9;
            min-height: 100vh;
            display: flex;
            align-items: center;
            justify-content: center;
            font-family: Arial, sans-serif;
        }

        .login-card {
            width: 100%;
            max-width: 420px;
            background: white;
            padding: 35px;
            border-radius: 12px;
            box-shadow: 0 5px 25px rgba(0,0,0,0.08);
        }

        .brand {
            color: #174a78;
            font-weight: bold;
            font-size: 25px;
        }

        .login-btn {
            background: #174a78;
            color: white;
            width: 100%;
            padding: 11px;
        }

        .login-btn:hover {
            background: #103657;
            color: white;
        }
    </style>
</head>
<body>

    <div class="login-card">

        <div class="text-center mb-4">
            <div class="brand">SCM ProcureTrack</div>
            <p class="text-muted mt-2">
                Supply Chain Procurement Management
            </p>
            <h4 class="mt-3">Welcome Back</h4>
            <p class="text-secondary">Login to continue</p>
        </div>

        <form asp-controller="Account"
              asp-action="Login"
              method="post">

            @Html.AntiForgeryToken()

            <input type="hidden"
                   name="returnUrl"
                   value="@ViewBag.ReturnUrl" />

            <div asp-validation-summary="ModelOnly"
                 class="text-danger mb-3"></div>

            <div class="mb-3">
                <label class="form-label">Email Address</label>
                <input type="email"
                       name="email"
                       class="form-control"
                       placeholder="Enter your email"
                       required />
            </div>

            <div class="mb-4">
                <label class="form-label">Password</label>
                <input type="password"
                       name="password"
                       class="form-control"
                       placeholder="Enter your password"
                       required />
            </div>

            <button type="submit" class="btn login-btn">
                Login
            </button>

        </form>

        <div class="text-center mt-4">
            <small class="text-muted">
                SCM ProcureTrack | Secure Access
            </small>
        </div>

    </div>

</body>
</html>
