
@using Microsoft.AspNetCore.Mvc.Rendering
@model DotNetAssignmentApp.ViewModels.PurchaseOrderViewModel

@{
    ViewData["Title"] = "Edit Purchase Order";
    var items = ViewBag.Items as IEnumerable<SelectListItem>
                ?? Enumerable.Empty<SelectListItem>();
}

<div class="container mt-4">
    <h2>Edit Purchase Order</h2>

    <p class="text-muted">
        Purchase Order: <strong>@ViewBag.PONumber</strong>
    </p>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-controller="PurchaseOrders"
                  asp-action="Edit"
                  asp-route-id="@ViewBag.PurchaseOrderId"
                  method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <h5 class="mb-3">Purchase Order Details</h5>

                <div class="row">
                    <div class="col-md-6 mb-3">
                        <label asp-for="VendorId" class="form-label">Vendor</label>
                        <select asp-for="VendorId"
                                asp-items="ViewBag.Vendors"
                                class="form-select">
                            <option value="">-- Select Vendor --</option>
                        </select>
                        <span asp-validation-for="VendorId"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="OrderDate" class="form-label"></label>
                        <input asp-for="OrderDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="OrderDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ExpectedDeliveryDate"
                               class="form-label"></label>
                        <input asp-for="ExpectedDeliveryDate"
                               type="date"
                               class="form-control" />
                        <span asp-validation-for="ExpectedDeliveryDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Remarks" class="form-label"></label>
                        <textarea asp-for="Remarks"
                                  class="form-control"
                                  rows="2"></textarea>
                        <span asp-validation-for="Remarks"
                              class="text-danger"></span>
                    </div>
                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5>Purchase Order Items</h5>
                    <button type="button"
                            class="btn btn-outline-primary btn-sm"
                            onclick="addItemRow()">
                        + Add Item
                    </button>
                </div>

                <div class="table-responsive">
                    <table class="table table-bordered align-middle">
                        <thead class="table-light">
                            <tr>
                                <th>Item</th>
                                <th>Quantity</th>
                                <th>Unit Price</th>
                                <th>Tax (%)</th>
                                <th>Action</th>
                            </tr>
                        </thead>

                        <tbody id="itemsTableBody">
                            @for (int i = 0; i < Model.Items.Count; i++)
                            {
                                <tr>
                                    <td>
                                        <select name="Items[@i].ItemId"
                                                class="form-select"
                                                required>
                                            <option value="">-- Select Item --</option>
                                            @foreach (var item in items)
                                            {
                                                if (item.Value == Model.Items[i].ItemId.ToString())
                                                {
                                                    <option value="@item.Value" selected>
                                                        @item.Text
                                                    </option>
                                                }
                                                else
                                                {
                                                    <option value="@item.Value">
                                                        @item.Text
                                                    </option>
                                                }
                                            }
                                        </select>
                                    </td>

                                    <td>
                                        <input name="Items[@i].OrderedQuantity"
                                               type="number"
                                               step="0.001"
                                               min="0.01"
                                               value="@Model.Items[i].OrderedQuantity"
                                               class="form-control"
                                               required />
                                    </td>

                                    <td>
                                        <input name="Items[@i].UnitPrice"
                                               type="number"
                                               step="0.01"
                                               min="0.01"
                                               value="@Model.Items[i].UnitPrice"
                                               class="form-control"
                                               required />
                                    </td>

                                    <td>
                                        <input name="Items[@i].TaxPercentage"
                                               type="number"
                                               step="0.01"
                                               min="0"
                                               max="100"
                                               value="@Model.Items[i].TaxPercentage"
                                               class="form-control"
                                               required />
                                    </td>

                                    <td>
                                        <button type="button"
                                                class="btn btn-danger btn-sm"
                                                onclick="removeItemRow(this)">
                                            Remove
                                        </button>
                                    </td>
                                </tr>
                            }
                        </tbody>
                    </table>
                </div>

                <div class="mt-3">
                    <button type="submit" class="btn btn-primary">
                        Update Purchase Order
                    </button>

                    <a asp-controller="PurchaseOrders"
                       asp-action="Index"
                       class="btn btn-secondary">
                        Cancel
                    </a>
                </div>

            </form>
        </div>
    </div>
</div>

@section Scripts {
    <partial name="_ValidationScriptsPartial" />

    <script>
        const itemOptions = `
            <option value="">-- Select Item --</option>
            @foreach (var item in items)
            {
                <option value="@item.Value">@Html.Raw(System.Text.Encodings.Web.HtmlEncoder.Default.Encode(item.Text))</option>
            }
        `;

        function updateItemIndexes() {
            const rows = document.querySelectorAll("#itemsTableBody tr");

            rows.forEach((row, index) => {
                row.querySelectorAll("input, select").forEach(control => {
                    const field = control.name.split(".")[1];
                    control.name = `Items[${index}].${field}`;
                });
            });
        }

        function addItemRow() {
            const tbody = document.getElementById("itemsTableBody");
            const row = document.createElement("tr");

            row.innerHTML = `
                <td>
                    <select class="form-select" required>
                        ${itemOptions}
                    </select>
                </td>
                <td>
                    <input type="number" step="0.001" min="0.01"
                           class="form-control" required />
                </td>
                <td>
                    <input type="number" step="0.01" min="0.01"
                           class="form-control" required />
                </td>
                <td>
                    <input type="number" step="0.01" min="0" max="100"
                           class="form-control" required />
                </td>
                <td>
                    <button type="button" class="btn btn-danger btn-sm"
                            onclick="removeItemRow(this)">
                        Remove
                    </button>
                </td>
            `;

            tbody.appendChild(row);

            const index = tbody.rows.length - 1;
            const controls = row.querySelectorAll("input, select");

            controls[0].name = `Items[${index}].ItemId`;
            controls[1].name = `Items[${index}].OrderedQuantity`;
            controls[2].name = `Items[${index}].UnitPrice`;
            controls[3].name = `Items[${index}].TaxPercentage`;
        }

        function removeItemRow(button) {
            const tbody = document.getElementById("itemsTableBody");

            if (tbody.rows.length <= 1) {
                alert("At least one purchase order item is required.");
                return;
            }

            button.closest("tr").remove();
            updateItemIndexes();
        }
    </script>
}
