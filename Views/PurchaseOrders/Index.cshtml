@model IEnumerable<DotNetAssignmentApp.Models.PurchaseOrder>

@{
    ViewData["Title"] = "Purchase Orders";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Purchase Orders</h2>
        <a asp-action="Create" class="btn btn-primary">
            + Create Purchase Order
        </a>
    </div>

    @if (TempData["Success"] != null)
    {
        <div class="alert alert-success">@TempData["Success"]</div>
    }

    @if (TempData["Error"] != null)
    {
        <div class="alert alert-danger">@TempData["Error"]</div>
    }

    <div class="card shadow-sm">
        <div class="card-body">

            <table class="table table-bordered table-hover">
                <thead class="table-dark">
                    <tr>
                        <th>PO Number</th>
                        <th>Vendor</th>
                        <th>Order Date</th>
                        <th>Expected Delivery</th>
                        <th>Subtotal</th>
                        <th>Tax Amount</th>
                        <th>Grand Total</th>
                        <th>Status</th>
                        <th>Actions</th>
                    </tr>
                </thead>

                <tbody>
                    @if (Model.Any())
                    {
                        @foreach (var po in Model)
                        {
                            <tr>
                                <td>@po.PONumber</td>
                                <td>@po.Vendor?.CompanyName</td>
                                <td>@po.OrderDate.ToString("dd-MM-yyyy")</td>
                                <td>@po.ExpectedDeliveryDate.ToString("dd-MM-yyyy")</td>
                                <td>@po.Subtotal.ToString("N2")</td>
                                <td>@po.TaxAmount.ToString("N2")</td>
                                <td>@po.GrandTotal.ToString("N2")</td>

                                <td>
                                    @if (po.Status == "Draft")
                                    {
                                        <span class="badge bg-secondary">Draft</span>
                                    }
                                    else if (po.Status == "Approved")
                                    {
                                        <span class="badge bg-success">Approved</span>
                                    }
                                    else if (po.Status == "Partially Received")
                                    {
                                        <span class="badge bg-warning text-dark">Partially Received</span>
                                    }
                                    else if (po.Status == "Completed")
                                    {
                                        <span class="badge bg-primary">Completed</span>
                                    }
                                    else if (po.Status == "Cancelled")
                                    {
                                        <span class="badge bg-danger">Cancelled</span>
                                    }
                                    else
                                    {
                                        <span class="badge bg-secondary">@po.Status</span>
                                    }
                                </td>

                                <td>
                                    <div class="d-flex gap-2 flex-wrap">

                                        @if (po.Status == "Draft")
                                        {
                                            <form asp-action="Approve"
                                                  asp-route-id="@po.PurchaseOrderId"
                                                  method="post">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-success">
                                                    Approve
                                                </button>
                                            </form>
                                        }

                                        @if (po.Status == "Approved" ||
                                             po.Status == "Partially Received")
                                        {
                                            <a asp-controller="GoodsReceipts"
                                               asp-action="CreateForPO"
                                               asp-route-purchaseOrderId="@po.PurchaseOrderId"
                                               class="btn btn-sm btn-primary">
                                                Receive Goods
                                            </a>
                                        }

                                        @if (po.Status == "Draft" ||
                                             po.Status == "Approved")
                                        {
                                            <form asp-action="Cancel"
                                                  asp-route-id="@po.PurchaseOrderId"
                                                  method="post"
                                                  onsubmit="return confirm('Are you sure you want to cancel this Purchase Order?');">
                                                @Html.AntiForgeryToken()

                                                <button type="submit"
                                                        class="btn btn-sm btn-danger">
                                                    Cancel
                                                </button>
                                            </form>
                                        }

                                        @if (po.Status == "Completed" ||
                                             po.Status == "Cancelled" ||
                                             po.Status == "Partially Received")
                                        {
                                            <span class="text-muted">No further actions</span>
                                        }

                                    </div>
                                </td>
                            </tr>
                        }
                    }
                    else
                    {
                        <tr>
                            <td colspan="9" class="text-center">
                                No Purchase Orders found.
                            </td>
                        </tr>
                    }
                </tbody>
            </table>

        </div>
    </div>
</div>