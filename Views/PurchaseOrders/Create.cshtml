
@model DotNetAssignmentApp.ViewModels.PurchaseOrderViewModel

@{
    ViewData["Title"] = "Create Purchase Order";
}

<div class="container mt-4">

    <h2 class="mb-4">Create Purchase Order</h2>

    <div class="card shadow-sm">
        <div class="card-body">

            <form asp-action="Create" method="post">

                @Html.AntiForgeryToken()

                <div asp-validation-summary="ModelOnly"
                     class="text-danger mb-3"></div>

                <h5 class="mb-3">Purchase Order Details</h5>

                <div class="row">

                    <div class="col-md-6 mb-3">
                        <label asp-for="VendorId" class="form-label">Vendor</label>
                        <select asp-for="VendorId"
                                asp-items="ViewBag.Vendors"
                                class="form-select">
                            <option value="">-- Select Vendor --</option>
                        </select>
                        <span asp-validation-for="VendorId" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="OrderDate" class="form-label">Order Date</label>
                        <input asp-for="OrderDate" type="date" class="form-control" />
                        <span asp-validation-for="OrderDate" class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="ExpectedDeliveryDate" class="form-label">
                            Expected Delivery Date
                        </label>
                        <input asp-for="ExpectedDeliveryDate"
                               type="date" class="form-control" />
                        <span asp-validation-for="ExpectedDeliveryDate"
                              class="text-danger"></span>
                    </div>

                    <div class="col-md-6 mb-3">
                        <label asp-for="Remarks" class="form-label">Remarks</label>
                        <textarea asp-for="Remarks" class="form-control"
                                  rows="2" placeholder="Enter remarks"></textarea>
                    </div>

                </div>

                <hr />

                <div class="d-flex justify-content-between align-items-center mb-3">
                    <h5 class="mb-0">Purchase Order Items</h5>
                    <button type="button" class="btn btn-success"
                            onclick="addItemRow()">
                        + Add Item
                    </button>
                </div>

                <div id="itemsContainer">

                    <div class="row border rounded p-3 mb-3 item-row">

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Item</label>
                            <select name="Items[0].ItemId"
                                    class="form-select" required>
                                <option value="">-- Select Item --</option>
                                @foreach (var item in (IEnumerable<Microsoft.AspNetCore.Mvc.Rendering.SelectListItem>)ViewBag.Items)
                                {
                                    <option value="@item.Value">@item.Text</option>
                                }
                            </select>
                        </div>

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Quantity</label>
                            <input name="Items[0].OrderedQuantity"
                                   type="number" step="0.001" min="0.01"
                                   class="form-control" required
                                   placeholder="Enter Quantity" />
                        </div>

                        <div class="col-md-3 mb-3">
                            <label class="form-label">Unit Price</label>
                            <input name="Items[0].UnitPrice"
                                   type="number" step="0.01" min="0.01"
                                   class="form-control" required
                                   placeholder="Enter Unit Price" />
                        </div>

                        <div class="col-md-2 mb-3">
                            <label class="form-label">Tax (%)</label>
                            <input name="Items[0].TaxPercentage"
                                   type="number" step="0.01" min="0" max="100"
                                   class="form-control" required
                                   placeholder="18" />
                        </div>

                        <div class="col-md-1 mb-3 d-flex align-items-end">
                            <button type="button"
                                    class="btn btn-danger remove-item"
                                    onclick="removeItemRow(this)"
                                    disabled>
                                X
                            </button>
                        </div>

                    </div>

                </div>

                <hr />

                <button type="submit" class="btn btn-primary">
                    Save Purchase Order
                </button>

                <a asp-action="Index" class="btn btn-secondary">
                    Cancel
                </a>

            </form>

        </div>
    </div>

</div>

@section Scripts {
    @{
        await Html.RenderPartialAsync("_ValidationScriptsPartial");
    }

    <script>
        let itemIndex = 1;

        function addItemRow() {

            const container = document.getElementById("itemsContainer");

            const firstRow = container.querySelector(".item-row");

            const newRow = firstRow.cloneNode(true);

            newRow.querySelectorAll("input").forEach(input => {
                input.value = "";
                input.name = input.name.replace(
                    /Items\[\d+\]/,
                    "Items[" + itemIndex + "]"
                );
            });

            newRow.querySelectorAll("select").forEach(select => {
                select.selectedIndex = 0;
                select.name = select.name.replace(
                    /Items\[\d+\]/,
                    "Items[" + itemIndex + "]"
                );
            });

            newRow.querySelector(".remove-item").disabled = false;

            container.appendChild(newRow);

            itemIndex++;
        }

        function removeItemRow(button) {

            const container = document.getElementById("itemsContainer");

            if (container.querySelectorAll(".item-row").length > 1) {
                button.closest(".item-row").remove();
            }
        }
    </script>
}
