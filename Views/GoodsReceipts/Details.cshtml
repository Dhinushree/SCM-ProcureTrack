
@model DotNetAssignmentApp.Models.GoodsReceiptNote

@{
    ViewData["Title"] = "GRN Details";
}

<div class="container mt-4">

    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Goods Receipt Details</h2>

        <a asp-action="Index" class="btn btn-secondary">
            Back to GRN List
        </a>
    </div>

    <!-- GRN Header Information -->
    <div class="card shadow-sm mb-4">
        <div class="card-header bg-dark text-white">
            <h5 class="mb-0">GRN Information</h5>
        </div>

        <div class="card-body">
            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>GRN Number:</strong>
                    <p>@Model.GRNNumber</p>
                </div>

                <div class="col-md-6">
                    <strong>Purchase Order Number:</strong>
                    <p>@(Model.PurchaseOrder?.PONumber ?? "N/A")</p>
                </div>
            </div>

            <div class="row mb-3">
                <div class="col-md-6">
                    <strong>Receipt Date:</strong>
                    <p>@Model.ReceiptDate.ToString("dd-MM-yyyy")</p>
                </div>

                <div class="col-md-6">
                    <strong>Status:</strong>
                    <p>
                        @if (Model.Status == "Posted")
                        {
                            <span class="badge bg-success">Posted</span>
                        }
                        else
                        {
                            <span class="badge bg-secondary">@Model.Status</span>
                        }
                    </p>
                </div>
            </div>

            <div>
                <strong>Remarks:</strong>
                <p>@(string.IsNullOrWhiteSpace(Model.Remarks)
                    ? "No remarks available"
                    : Model.Remarks)</p>
            </div>
        </div>
    </div>

    <!-- Received Item Details -->
    <div class="card shadow-sm">
        <div class="card-header bg-primary text-white">
            <h5 class="mb-0">Received Item Details</h5>
        </div>

        <div class="card-body">

            <div class="table-responsive">
                <table class="table table-bordered table-hover">

                    <thead class="table-dark">
                        <tr>
                            <th>Item Code</th>
                            <th>Item Name</th>
                            <th>Ordered Qty</th>
                            <th>Received Qty</th>
                            <th>Accepted Qty</th>
                            <th>Rejected Qty</th>
                            <th>Inspection Remarks</th>
                        </tr>
                    </thead>

                    <tbody>
                        @if (Model.ReceiptDetails != null &&
                             Model.ReceiptDetails.Any())
                        {
                            @foreach (var detail in Model.ReceiptDetails)
                            {
                                <tr>
                                    <td>
                                        @(detail.PurchaseOrderDetail?.Item?.ItemCode ?? "N/A")
                                    </td>

                                    <td>
                                        @(detail.PurchaseOrderDetail?.Item?.ItemName ?? "N/A")
                                    </td>

                                    <td>
                                        @(detail.PurchaseOrderDetail?.OrderedQuantity.ToString("N2") ?? "N/A")
                                    </td>

                                    <td>@detail.ReceivedQuantity.ToString("N2")</td>

                                    <td>
                                        <span class="text-success fw-bold">
                                            @detail.AcceptedQuantity.ToString("N2")
                                        </span>
                                    </td>

                                    <td>
                                        <span class="text-danger fw-bold">
                                            @detail.RejectedQuantity.ToString("N2")
                                        </span>
                                    </td>

                                    <td>
                                        @(string.IsNullOrWhiteSpace(detail.InspectionRemarks)
                                            ? "-"
                                            : detail.InspectionRemarks)
                                    </td>
                                </tr>
                            }
                        }
                        else
                        {
                            <tr>
                                <td colspan="7" class="text-center">
                                    No receipt item details found.
                                </td>
                            </tr>
                        }
                    </tbody>

                </table>
            </div>

        </div>
    </div>

    <div class="mt-3">
        <a asp-action="Index" class="btn btn-secondary">
            Back to GRN List
        </a>
    </div>

</div>
